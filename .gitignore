# Python
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
.pytest_cache/
.venv/
venv/
env/
ENV/

# Backend runtime data
backend/outputs/
!backend/outputs/
!backend/outputs/.gitkeep
backend/outputs/*
!backend/outputs/.gitkeep

# Environment / secrets (prevent all credentials and env files)
.env
.env.*
*.env
backend/.env
backend/.env.*
frontend/gst-gem-main/.env
frontend/gst-gem-main/.env.*
*.local
# Preserved example configs
!.env.example
!*.env.example
!backend/.env.example
!frontend/gst-gem-main/.env.example

# Node / frontend dependencies & build outputs
node_modules/
**/node_modules/
dist/
dist-ssr/
build/
.tanstack/
.vinxi/
.nitro/
.wrangler/
frontend/gst-gem-main/node_modules/
frontend/gst-gem-main/dist/
frontend/gst-gem-main/.tanstack/
frontend/gst-gem-main/.wrangler/

# Logs, testing & runtime artifacts
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
test-results/
playwright-report/
coverage/

# IDE and OS
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store

